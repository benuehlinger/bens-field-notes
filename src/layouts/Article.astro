---
import Site from './Site.astro';
interface Props {
  frontmatter: { title: string; subtitle?: string; description?: string; active?: string };
}
const { frontmatter } = Astro.props;
---

<Site title={frontmatter.title} description={frontmatter.description} active={frontmatter.active}>
  <article class="article-shell">
    <div class="breadcrumbs">
      <a href="/ai-engineering/">AI engineering</a>
      <span>/</span>
      <span>{frontmatter.active === 'learning' ? 'Currently learning' : 'Field notes'}</span>
    </div>
    <header class="article-header">
      <h1>{frontmatter.title}</h1>
      {frontmatter.subtitle && <p>{frontmatter.subtitle}</p>}
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</Site>
