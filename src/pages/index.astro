---
import Site from '../layouts/Site.astro';
import Icon from '../components/Icon.astro';
import '../styles/portfolio.css';

const work = [
  {
    area: 'Applied AI',
    title: 'AI Engineering Field Notes',
    description: 'Questions, experiments, and a source atlas for building with AI.',
    href: '/applied-ai/',
  },
  {
    area: 'Data Engineering',
    title: 'Lending Data Lake',
    description:
      'A pipeline that turns SEC asset-backed securities filings into queryable loan data.',
    href: '/data-engineering/',
  },
  {
    area: 'Data Science',
    title: 'Credit Risk Research',
    description: 'Research notes and planned predictive analysis of auto-loan performance.',
    href: '/data-science/',
  },
];
---

<Site title="Ben Uehlinger" active="about">
  <div class="portfolio">
    <section class="portfolio-hero" aria-labelledby="portfolio-name">
      <h1 id="portfolio-name">Ben Uehlinger</h1>
      <p class="portfolio-role">Senior Forward Deployed Engineer at Eliza</p>
      <div class="portfolio-disciplines">
        <span class="portfolio-still">Applied AI</span>
        <button class="portfolio-typed" type="button" aria-label="Pause rotating text">
          {work.map(({ area }, index) => (
            <span
              aria-hidden="true"
              style={{ '--letters': area.length, '--delay': `${index * 3000}ms` }}
            >
              {area}
            </span>
          ))}
        </button>
      </div>
    </section>

    <section class="portfolio-about" id="about" aria-labelledby="about-title">
      <h2 id="about-title">About me</h2>
      <div>
        <p>
          At Eliza, I work directly with customers to figure out where AI can help and build it into
          their day-to-day work.
        </p>
        <p>
          Before Eliza, I worked as a data scientist in credit risk. I built a lending data lake
          from SEC filings so I could work with loan-level data and study how auto loans perform.
          This site is where I share the projects and questions I keep coming back to.
        </p>
      </div>
    </section>

    <section class="portfolio-work" aria-labelledby="work-title">
      <h2 id="work-title">Selected work</h2>
      <ul class="portfolio-rows">
        {work.map(({ area, title, description, href }) => (
          <li>
            <a href={href}>
              <span class="portfolio-category">{area}</span>
              <div>
                <h3>{title}</h3>
                <p>{description}</p>
              </div>
              <Icon name="arrow" size={21} />
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Site>

<script>
  const rotation = document.querySelector<HTMLButtonElement>('.portfolio-typed');
  rotation?.addEventListener('click', () => {
    const paused = rotation.toggleAttribute('data-paused');
    rotation.setAttribute('aria-label', paused ? 'Resume rotating text' : 'Pause rotating text');
  });
</script>
