---
import Site from '../../layouts/Site.astro';
import Sources from '../../components/Sources.astro';
---

<Site title="Source library" active="sources">
  <div class="shell library-page">
    <div class="page-intro">
      <div>
        <h1 id="library-title">Source library.</h1>
        <p>127 sources to learn from, keep up with, and contribute to.</p>
      </div>
    </div>
    <Sources standalone />
    <p class="quiet-note">
      127 sources, checked 25 November 2026. Select Details for suggested uses, access information
      and contribution routes.
    </p>
  </div>
</Site>
