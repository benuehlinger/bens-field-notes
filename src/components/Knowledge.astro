---
import Site from '../layouts/Site.astro';
import Modes from './Modes.astro';
import Atlas from './Atlas.astro';
import Sources from './Sources.astro';
import Icon from './Icon.astro';
import { areas, questions, storyUrl, shortName } from '../lib/knowledge.mjs';
const { home = false } = Astro.props;
---

<Site title={home ? 'A working understanding' : 'AI engineering'} active="knowledge">
  <div class="shell">
    <div class="page-intro">
      <div>
        <h1>{home ? 'A working understanding.' : 'AI engineering.'}</h1>
        <p>
          {home
            ? 'Learning AI engineering, one question at a time.'
            : 'The sources, questions and people helping me understand what I’m building.'}
        </p>
      </div>
      <a class="learning-mini" href={storyUrl}>
        <span />
        <span>
          <small>Currently learning</small>
          <strong>smolagents vs LangGraph</strong>
        </span>
        <Icon name="arrow" size={15} />
      </a>
    </div>
    <Modes active="learn" />
    <Atlas />
    <Sources inline />
    <div class="below-atlas">
      <section class="current-story" aria-labelledby="current-story-title">
        <div>
          <div class="section-note">Currently learning</div>
          <h2 id="current-story-title">
            <a href={storyUrl}>
              smolagents vs LangGraph <span aria-hidden="true">↗</span>
            </a>
          </h2>
          <p>
            How do these tools run an agent, and where does T3 Code fit? I’m starting with a small
            problem and exploring it one notebook block at a time.
          </p>
          <a class="text-link" href={storyUrl}>
            Read the opening questions <Icon name="arrow" size={14} />
          </a>
        </div>
        <div>
          <div class="story-diagram">
            <div>
              <b>smolagents</b>
              <span>Expressing an agent’s actions</span>
            </div>
            <div>
              <b>LangGraph</b>
              <span>Controlling state and execution</span>
            </div>
            <div>
              <b>T3 Code</b>
              <span>Working with coding agents</span>
            </div>
          </div>
          <div class="story-status">Opening questions. No experiment run yet.</div>
        </div>
      </section>
      <div class="section-heading">
        <h2>Questions worth following</h2>
        <a class="quiet-link" href="/ai-engineering/questions.html">
          All questions <Icon name="arrow" size={13} />
        </a>
      </div>
      <div class="question-list">
        {questions.map((question) => (
          <a
            class="question-item"
            href={
              question.investigation ? question.investigation : `/ai-engineering/questions.html#${question.id}`
            }
          >
            <h3>{question.title}</h3>
            <p>{question.description}</p>
          </a>
        ))}
      </div>
      <details class="guide-index">
        <summary>
          Browse the field guides<span>Twelve connected areas</span>
        </summary>
        <div class="guide-grid">
          {areas.map((area) => (
            <a href={`/ai-engineering/topics/${area.slug}.html`}>
              {shortName(area)} <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </details>
    </div>
  </div>
</Site>
